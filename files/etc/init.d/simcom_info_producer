#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

SCRIPT_PATH="/usr/bin/simcom_info_producer.lua"
INTERVAL=10  # Period in seconds

start_service() {
    procd_open_instance modem_monitor

    procd_set_param command /bin/sh -c "while true; do /usr/bin/lua $SCRIPT_PATH; sleep $INTERVAL; done"

    # Restart if process dies
    procd_set_param respawn 3600 5 0

    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}
