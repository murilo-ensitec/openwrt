#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/lua"
SCRIPT="/usr/bin/cpu_monitor.lua"

start_service() {
    procd_open_instance
    procd_set_param command $PROG $SCRIPT
    procd_set_param respawn # Auto-restart if script dies
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
