#!/bin/sh /etc/rc.common

START=98
STOP=10
USE_PROCD=1

PROG="/usr/bin/lua"
SCRIPT="/usr/bin/simcom_watchdog.lua"

start_service() {
    procd_open_instance
    procd_set_param command $PROG $SCRIPT
    procd_set_param respawn 3600 5 0   # Auto-restart on crash (5 retries per hour)
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
