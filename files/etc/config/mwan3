config globals 'globals'
        option mmx_mask '0x3F00'

config interface 'wan'
        option enabled '1'
        option family 'ipv4'
        list track_ip '8.8.8.8'
        list track_ip '1.1.1.1'
        option reliability '1'
        option count '1'
        option timeout '2'
        option interval '5'
        option down '3'
        option up '3'
        list flush_conntrack 'connected'

config interface 'cwan'
        option enabled '1'
        option family 'ipv4'
        list track_ip '8.8.4.4'
        list track_ip '1.0.0.1'
        option reliability '1'
        option count '1'
        option timeout '2'
        option interval '5'
        option down '3'
        option up '3'

config member 'wan_m1'
        option interface 'wan'
        option metric '1'
        option weight '1'

config member 'cwan_m2'
        option interface 'cwan'
        option metric '2'
        option weight '1'

config policy 'failover'
        list use_member 'wan_m1'
        list use_member 'cwan_m2'

config rule 'default_rule'
        option family 'ipv4'
        option proto 'all'
        option dest_ip '0.0.0.0/0'
        option use_policy 'failover'

