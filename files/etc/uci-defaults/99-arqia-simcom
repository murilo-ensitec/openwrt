#!/bin/sh

# Configuring the simcom UCI Interface
uci set network.cwan=interface
uci set network.cwan.proto='qmi'
uci set network.cwan.device='/dev/cdc-wdm0'
uci set network.cwan.apn='iot4u.br'
uci set network.cwan.pdptype='ipv4'
uci set network.cwan.auth='pap'
uci set network.cwan.username='arqia'
uci set network.cwan.password='arqia'
uci set network.cwan.metric='30'
uci set network.cwan.delay='10'
uci set network.cwan.rawip='1'

# Configuring the Ethernet UCI Interface
uci set network.wan.metric='10'
uci set network.wan.ipaddr='192.168.5.1/24'

# Configuring the LAN UCI Network Interface
uci set network.lan.ipaddr='192.168.5.1/24'

uci commit network

uci add_list firewall.@zone[1].network='cwan'
uci commit firewall

exit 0
